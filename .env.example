# ── Database ──────────────────────────────────────────────
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# ── LLM provider ──────────────────────────────────────────
# Auto-detected from whichever key is set below. This project uses Gemini.
# AGENT_LLM_PROVIDER=gemini
# Cheap default model (overridable). Effective default: gemini-2.5-flash
# (spec names gemini-2.0-flash, but it 404s on the live API in this environment):
# AGENT_LLM_MODEL=gemini-2.5-flash

# Set the Gemini key (required — this is the single manual setup step):
AGENT_GEMINI_API_KEY=
# Optional alternative provider:
AGENT_ANTHROPIC_API_KEY=

# ── Analysis / sandbox tuning (optional; sensible defaults) ─
# AGENT_SAMPLE_ROWS=5                # rows of sample data sent to the LLM
# AGENT_SANDBOX_TIMEOUT_SECONDS=15   # per-execution wall-clock timeout
# AGENT_MAX_RETRIES=3                # bounded error-fix retries

# ── Conversation Intelligence (Phase 4) classifier (optional; sensible defaults) ─
# AGENT_CLASSIFY_MODEL=gemini-2.5-flash-lite  # fast, low-cost classification model
# AGENT_CLASSIFY_BATCH_SIZE=15                # transcripts per Gemini request
# AGENT_CLASSIFY_CONCURRENCY=4                # bounded concurrent batches
# AGENT_TRANSCRIPT_MAX_CHARS=6000             # per-transcript truncation before sending
# AGENT_TAXONOMY_SAMPLE_SIZE=100              # transcripts sampled to derive the taxonomy

PORT=8001
